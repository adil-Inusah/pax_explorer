from __future__ import annotations

import json
import sys
from collections import Counter
from datetime import datetime, timezone
from pathlib import Path
from typing import Any

ROOT_DIR = Path(__file__).resolve().parent.parent
if str(ROOT_DIR) not in sys.path:
    sys.path.insert(0, str(ROOT_DIR))

from parsers.ti_parameter_resolver import (
    normalized,
    resolve_parameter_relationships,
)
from parsers.ti_parser import (
    parse_process,
    summarize_relationships,
    validate_relationships,
)
from utilities.tm1_connection import get_tm1_connection

CURRENT_ROOT = ROOT_DIR / "data" / "current"
SNAPSHOT_ROOT = ROOT_DIR / "data" / "snapshots"
EXCEPTION_FILE_CANDIDATES = (
    ROOT_DIR / "config" / "Catalog_quality_exceptions.json",
    ROOT_DIR / "config" / "catalog_quality_exceptions.json",
)


def utc_now() -> datetime:
    return datetime.now(timezone.utc)


def snapshot_id(timestamp: datetime) -> str:
    return timestamp.strftime("%Y%m%dT%H%M%SZ")


def read_json(path: Path) -> Any:
    with path.open("r", encoding="utf-8-sig") as file:
        return json.load(file)


def write_json(path: Path, payload: Any) -> None:
    path.parent.mkdir(parents=True, exist_ok=True)
    temporary_path = path.with_suffix(path.suffix + ".tmp")
    with temporary_path.open("w", encoding="utf-8") as file:
        json.dump(payload, file, indent=2, ensure_ascii=False)
        file.write("\n")
    temporary_path.replace(path)


def read_quality_exceptions() -> Any:
    for path in EXCEPTION_FILE_CANDIDATES:
        if path.is_file():
            return read_json(path)
    return {"exceptions": []}


def get_process_procedures(process: Any) -> dict[str, str]:
    candidates = {
        "Prolog": ("prolog_procedure", "PrologProcedure"),
        "Metadata": ("metadata_procedure", "MetadataProcedure"),
        "Data": ("data_procedure", "DataProcedure"),
        "Epilog": ("epilog_procedure", "EpilogProcedure"),
    }
    procedures: dict[str, str] = {}
    for procedure_name, property_names in candidates.items():
        value = ""
        for property_name in property_names:
            if hasattr(process, property_name):
                value = getattr(process, property_name) or ""
                break
        procedures[procedure_name] = str(value)
    return procedures


def normalize_process_parameters(process: Any) -> list[dict[str, Any]]:
    raw_parameters = getattr(process, "parameters", None)
    if raw_parameters is None:
        raw_parameters = getattr(process, "_parameters", None)
    result: list[dict[str, Any]] = []
    for position, raw in enumerate(raw_parameters or [], start=1):
        if isinstance(raw, dict):
            mapping = {str(key).casefold(): value for key, value in raw.items()}
            name = mapping.get("name")
            prompt = mapping.get("prompt")
            value = mapping.get("value")
            parameter_type = mapping.get("type")
        else:
            name = getattr(raw, "name", None) or getattr(raw, "Name", None)
            prompt = getattr(raw, "prompt", None) or getattr(raw, "Prompt", None)
            value = getattr(raw, "value", None)
            if value is None:
                value = getattr(raw, "Value", None)
            parameter_type = getattr(raw, "type", None) or getattr(raw, "Type", None)
        name_text = str(name or "").strip()
        if not name_text:
            continue
        result.append(
            {
                "parameter_name": name_text,
                "parameter_type": str(parameter_type or "UNKNOWN").strip(),
                "prompt": str(prompt or "").strip(),
                "default_value": value,
                "has_nonempty_default": value is not None and str(value).strip() != "",
                "position": position,
            }
        )
    return result


def relationship_key(record: Any) -> tuple[str, str, str, str]:
    if isinstance(record, dict):
        return (
            normalized(record.get("process_name") or record.get("source_name")),
            normalized(record.get("relationship_type")),
            normalized(record.get("target_type") or record.get("target_object_type")),
            normalized(record.get("target_name")),
        )
    return (
        normalized(record.process_name),
        normalized(record.relationship_type),
        normalized(record.target_type),
        normalized(record.target_name),
    )


def enrich_payload(
    payload: list[dict[str, Any]],
    provenance_by_key: dict[tuple[str, str, str, str], list[dict[str, Any]]],
) -> None:
    for record in payload:
        provenance = provenance_by_key.get(relationship_key(record), [])
        if not provenance:
            continue
        record["parameter_resolution_applied"] = True
        record["resolution_provenance"] = provenance
        record["resolution_source"] = sorted(
            {str(item.get("source_kind") or "") for item in provenance if item.get("source_kind")}
        )
        record["calling_processes"] = sorted(
            {str(item.get("calling_process")) for item in provenance if item.get("calling_process")},
            key=str.casefold,
        )


def collect_ti_lineage() -> dict[str, Any]:
    objects_path = CURRENT_ROOT / "objects.json"
    if not objects_path.is_file():
        raise FileNotFoundError(
            "Current object catalog was not found. Run collect_tm1_metadata.py first."
        )

    object_catalog = read_json(objects_path)
    quality_exceptions = read_quality_exceptions()
    started_at = utc_now()
    run_snapshot_id = snapshot_id(started_at)
    output_directory = SNAPSHOT_ROOT / run_snapshot_id / "ti_lineage"

    process_definitions: list[dict[str, Any]] = []
    process_definition_index: dict[str, dict[str, Any]] = {}
    all_evidence = []
    errors: list[dict[str, str]] = []

    with get_tm1_connection() as tm1:
        process_names = sorted(tm1.processes.get_all_names(), key=str.casefold)
        for process_name in process_names:
            try:
                process = tm1.processes.get(process_name)
                procedures = get_process_procedures(process)
                parameters = normalize_process_parameters(process)
                evidence = parse_process(process_name, procedures)
                all_evidence.extend(evidence)
                definition = {
                    "process_name": process_name,
                    "parameters": parameters,
                    "procedures": procedures,
                    "relationship_evidence_count": len(evidence),
                }
                process_definitions.append(definition)
                process_definition_index[process_name] = definition
            except Exception as error:
                errors.append(
                    {
                        "process_name": process_name,
                        "error": f"{type(error).__name__}: {error}",
                    }
                )

    direct_summaries = summarize_relationships(all_evidence)
    resolution = resolve_parameter_relationships(
        direct_summaries,
        process_definitions=process_definition_index,
        object_catalog=object_catalog,
    )
    summaries = resolution.summaries
    validations = validate_relationships(
        summaries,
        object_catalog,
        quality_exceptions,
    )

    evidence_payload = [record.to_dict() for record in all_evidence]
    summary_payload = [record.to_dict() for record in summaries]
    enrich_payload(summary_payload, resolution.provenance_by_key)
    enrich_payload(validations, resolution.provenance_by_key)

    validation_counts = Counter(
        str(record.get("validation_status") or record.get("status") or "UNKNOWN")
        for record in validations
    )
    registered_exception_count = sum(
        bool(record.get("exception_id")) for record in validations
    )
    excluded_relationship_count = sum(
        record.get("exclude_from_quality_score") is True
        for record in validations
    )

    completed_at = utc_now()
    manifest = {
        "snapshot_id": run_snapshot_id,
        "started_at": started_at.isoformat(),
        "completed_at": completed_at.isoformat(),
        "status": "PARTIAL" if errors else "COMPLETE",
        "process_count": len(process_definitions),
        "parameter_count": len(resolution.parameters),
        "parameter_binding_count": len(resolution.bindings),
        "parameter_alias_count": len(resolution.aliases),
        "parameter_rejection_count": len(resolution.rejections),
        "parameter_resolution_metrics": resolution.metrics,
        "evidence_count": len(evidence_payload),
        "direct_relationship_count": len(direct_summaries),
        "relationship_count": len(summary_payload),
        "validation_count": len(validations),
        "validation_counts": dict(sorted(validation_counts.items())),
        "registered_exception_count": registered_exception_count,
        "excluded_relationship_count": excluded_relationship_count,
        "error_count": len(errors),
    }

    artifacts = {
        "process_definitions.json": (
            process_definitions
        ),
        "relationship_evidence.json": (
            evidence_payload
        ),
        "relationships.json": (
            summary_payload
        ),
        "relationship_validations.json": (
            validations
        ),
        "errors.json": errors,
        "manifest.json": manifest,
    }
    for file_name, payload in artifacts.items():
        write_json(output_directory / file_name, payload)

    if manifest["status"] == "COMPLETE":
        current_artifacts = {
            "ti_process_definitions.json": process_definitions,
            "ti_relationship_evidence.json": evidence_payload,
            "ti_relationships.json": summary_payload,
            "ti_relationship_validations.json": validations,
            "ti_process_parameters.json": resolution.parameters,
            "ti_parameter_bindings.json": resolution.bindings,
            "ti_parameter_aliases.json": resolution.aliases,
            "ti_parameter_resolution_rejections.json": resolution.rejections,
            "ti_parameter_resolution_metrics.json": resolution.metrics,
            "ti_lineage_manifest.json": manifest,
        }
        for file_name, payload in current_artifacts.items():
            write_json(CURRENT_ROOT / file_name, payload)

    return manifest

def print_manifest(
    manifest: dict[str, Any],
) -> None:
    """Print both legacy and parameter-aware TI manifests."""

    metrics = (
        manifest.get(
            "parameter_resolution_metrics"
        )
        or {}
    )

    relationship_count = int(
        manifest.get(
            "relationship_count",
            0,
        )
        or 0
    )

    direct_relationship_count = int(
        manifest.get(
            "direct_relationship_count",
            relationship_count,
        )
        or 0
    )

    validation_count = int(
        manifest.get(
            "validation_count",
            relationship_count,
        )
        or 0
    )

    parameter_count = int(
        manifest.get(
            "parameter_count",
            0,
        )
        or 0
    )

    parameter_binding_count = int(
        manifest.get(
            "parameter_binding_count",
            0,
        )
        or 0
    )

    parameter_rejection_count = int(
        manifest.get(
            "parameter_rejection_count",
            0,
        )
        or 0
    )

    derived_relationship_count = int(
        metrics.get(
            "derived_relationship_count",
            0,
        )
        or 0
    )

    replaced_unresolved_count = int(
        metrics.get(
            "replaced_unresolved_count",
            0,
        )
        or 0
    )

    print("=" * 70)
    print("TM1 TI PROCESS LINEAGE")
    print("=" * 70)

    print(
        "Snapshot               : "
        f"{manifest.get('snapshot_id', 'UNKNOWN')}"
    )

    print(
        "Status                 : "
        f"{manifest.get('status', 'UNKNOWN')}"
    )

    print(
        "Processes              : "
        f"{int(manifest.get('process_count', 0) or 0):,}"
    )

    print(
        "Parameters             : "
        f"{parameter_count:,}"
    )

    print(
        "Parameter bindings     : "
        f"{parameter_binding_count:,}"
    )

    print(
        "Evidence               : "
        f"{int(manifest.get('evidence_count', 0) or 0):,}"
    )

    print(
        "Direct relationships   : "
        f"{direct_relationship_count:,}"
    )

    print(
        "Published relationships: "
        f"{relationship_count:,}"
    )

    print(
        "Derived relationships  : "
        f"{derived_relationship_count:,}"
    )

    print(
        "Replaced unresolved    : "
        f"{replaced_unresolved_count:,}"
    )

    print(
        "Rejected candidates    : "
        f"{parameter_rejection_count:,}"
    )

    print(
        "Validations            : "
        f"{validation_count:,}"
    )

    print(
        "Errors                 : "
        f"{int(manifest.get('error_count', 0) or 0):,}"
    )

def main() -> int:
    try:
        manifest = collect_ti_lineage()
        print_manifest(manifest)

        return (
            0
            if manifest.get("status") == "COMPLETE"
            else 1
        )

    except Exception as error:
        print(
            "Lineage collection failed: "
            f"{type(error).__name__}: {error}"
        )
        return 1


if __name__ == "__main__":
    raise SystemExit(main())
